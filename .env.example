# Optional: Base path when app is served from a subdirectory (e.g. /video/).
# Set to /video for https://presenting.link/video/
# VITE_BASE_PATH=/video

# Video workflow API (POST). Body: { "Payloadlist": "<id from ?id=>" }
# Default: https://cdn.ekphrastic.io/api/wf/video
# Appends ?mode=test when viewer URL includes mode=test
# VITE_VIDEO_API_URL=https://cdn.ekphrastic.io/api/wf/video

# Tracking workflows (when ?uid= is in viewer URL).
# VITE_TRACK_VISITOR_START_URL=https://cdn.ekphrastic.io/api/wf/track_visit_start
# VITE_TRACK_EVENTS_URL=https://cdn.ekphrastic.io/api/wf/track_events

# Optional: Google Analytics 4 measurement ID (fallback when API presenter has no G4A).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
